{
  "name": "votebattle",
  "description": "Imprezja Quiz – quiz i głosowanie w sieci lokalnej (działa offline)",
  "version": "1.1.6",
  "author": "Damian Nowaczyk",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "kill-port": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "electron:fresh": "npm run kill-port && sleep 2 && electron .",
    "electron:dev": "npm run kill-port && sleep 2 && electron .",
    "clean": "node scripts/clean.js",
    "electron": "npm run kill-port && sleep 2 && electron .",
    "dist": "electron-builder",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:mac:universal": "electron-builder --mac --universal",
    "build:mac:x64": "electron-builder --mac --x64",
    "build:mac:intel": "electron-builder --mac --x64",
    "build:mac:arm64": "electron-builder --mac --arm64",
    "build:win": "NODE_OPTIONS=--max-old-space-size=8192 electron-builder --win --x64",
    "build:njr": "node scripts/prepare-njr-for-electron.js",
    "build:all-in-one": "npm run build:njr && electron-builder",
    "build:all-in-one:mac": "npm run build:njr && npm run build:mac",
    "build:all-in-one:win": "npm run build:njr && npm run build:win",
    "pac": "node scripts/clean.js && npm run build:mac:arm64 && npm run build:mac:x64 && npm run build:win",
    "build:launcher": "pkg launcher.js --targets node18-win-x64 --output dist/ImprezjaQuiz-Launcher.exe",
    "license-key": "node scripts/generate-license-key.js",
    "simulate:trial": "IMPREZJA_SIMULATE_TRIAL=1 node server.js",
    "simulate:trial:electron": "IMPREZJA_SIMULATE_TRIAL=1 electron .",
    "simulate:license-expired": "IMPREZJA_SIMULATE_LICENSE_EXPIRED=1 node server.js",
    "simulate:license-expired:electron": "IMPREZJA_SIMULATE_LICENSE_EXPIRED=1 electron ."
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/pixelify-sans": "^5.2.7",
    "@fontsource/press-start-2p": "^5.2.7",
    "@fontsource/rubik-pixels": "^5.2.8",
    "@fontsource/share-tech-mono": "^5.2.7",
    "@fontsource/vt323": "^5.2.7",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "cloudflared": "^0.7.1",
    "electron-updater": "^6.7.3",
    "express": "^4.21.1",
    "jimp": "^0.22.10",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^28.3.0",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "pl.imprezja.votebattle",
    "productName": "Imprezja Quiz",
    "copyright": "Copyright © Damian Nowaczyk. Wszelkie prawa zastrzeżone.",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "resources/njr-converter/**",
      "!tools/vdj-database-editor/**",
      "!public/quizzes/Quiz Kardasz.json",
      "!public/quizzes/Quiz Emil.json",
      "!public/quizzes/Quiz Dominika i Mateusz 2026.json",
      "!public/uploads/177021*",
      "!public/uploads/177037*",
      "!public/uploads/177038*",
      "!public/uploads/177090*",
      "!public/uploads/177091*",
      "!node_modules/.cache",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/doc/**",
      "!node_modules/**/docs/**",
      "!node_modules/**/*.md",
      "!node_modules/**/.*",
      "!**/.DS_Store",
      "!**/._*",
      "!**/*.dmg",
      "!**/*.pkg",
      "!docs",
      "!**/*.md",
      "!css",
      "!js",
      "!*.bat",
      "!*.command",
      "!*.sh",
      "!electron-main-test.js",
      "!electron-main-minimal.js",
      "!nw-main.js",
      "!package-nw.json",
      "!package.json-RECOVERY",
      "!scripts",
      "!launcher.js",
      "!license-private.pem",
      "!VoteBattle-zrodla*.zip",
      "!resources/tunnelmole-windows/**",
      "!scripts/download-tmole-windows.js"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/cloudflared/**",
      "resources/njr-converter/**"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "minimumSystemVersion": "10.13",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "singleArchFiles": "**/node_modules/@img/**"
    },
    "win": {
      "extraResources": [
        {
          "from": "resources/cloudflared-windows/cloudflared.exe",
          "to": "cloudflared.exe"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "ImprezjaQuiz"
    },
    "publish": {
      "provider": "github",
      "owner": "djdamsza",
      "repo": "Imprezja-Quiz-1.0.2-beta",
      "releaseType": "release"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Imprezja Quiz",
      "installerLanguages": [
        "pl"
      ]
    },
    "dmg": {
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 200,
          "type": "file"
        },
        {
          "x": 410,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}