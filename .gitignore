# Zależności i build – NIE KOPIOWAĆ (npm install i build odtworzą)
node_modules/
dist/

# Logi i pliki tymczasowe
*.log
imprezja-electron.log
LOG-LOCATION.txt
FATAL-ERROR.txt
.DS_Store
._*
Thumbs.db

# Certyfikaty i env
certs/
.env
.env.*

# Klucz prywatny licencji (TYLKO do generowania kluczy – nie w repozytorium!)
license-private.pem

# Cursor IDE – konfiguracja lokalna, nie do repo
.cursor/
.cursorignore

# Uploady użytkownika (duże obrazy/wideo) — GitHub odrzuca pliki >100 MB
public/uploads/*
# Seed samplera i gier muzycznych (wspólny, mały) – MUSI być w git, żeby build nie wychodził pusty
!public/uploads/sfx/
!public/uploads/sfx/**
!public/uploads/*.mp3
!public/uploads/*.vdjsample
!public/uploads/1773387852594-whitney-houston-t-660.webp

# Prywatna zawartość Imprezatora – nie publikować playlisty DJ-a w instalatorze / GitHubie
public/imprezator-configs/*.json

